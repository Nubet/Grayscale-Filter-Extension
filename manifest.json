{
  "manifest_version": 3,
  "name": "Grayscale Filter",
  "version": "1.0",
  "description": "Apply a clean grayscale look to every website you visit - no data collection, no tracking. Fully customizable intensity, open-source and privacy-friendly. Enjoy a calm, focused browsing experience while keeping full control over which sites stay in color.",
  "developer": {
  "name": "Nubet",
  "url": "https://github.com/Nubet"
  },
  "action": {
    "default_title": "Grayscale Filter",
    "default_popup": "src/ui/popup.html"
  },
  "icons": {
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "options_ui": {
    "page": "src/ui/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["src/background/background.js"]
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "css": ["src/content/grayscale.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/grayscale.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
  "gecko": {
    "id": "grayscale-filter@nubet",
    "strict_min_version": "109.0",
    "data_collection_permissions": {
      "required": ["none"],
      "optional": []
    }
  }
  } 
}
