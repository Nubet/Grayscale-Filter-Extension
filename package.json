{
  "name": "grayscale-everywhere",
  "version": "3.0.1",
  "description": "Cross-browser extension that applies a customizable grayscale filter to any website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run dev:chrome",
    "dev:chrome": "extension dev --browser=chrome --polyfill",
    "dev:firefox": "extension dev --browser=firefox",
    "build": "extension build --browser=chrome,firefox --polyfill",
    "build:chrome": "extension build --browser=chrome --polyfill",
    "build:firefox": "extension build --browser=firefox",
    "start:chrome": "extension start --browser=chrome --polyfill",
    "start:firefox": "extension start --browser=firefox"
  },
  "devDependencies": {
    "extension": "4.1.27",
    "webextension-polyfill": "^0.12.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "author": "Nubet",
  "license": "MIT"
}
